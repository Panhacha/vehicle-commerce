PORT=8080

# =====================================================================
# SUPABASE DATABASE CONFIGURATION (ជ្រើសរើស Option 1 ឬ Option 2)
# =====================================================================

# Option 1: ប្រើ Connection String ទាំងមូល (URI ពី Supabase Settings -> Database)
# ឧទាហរណ៍៖
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Option 2: ប្រើ Parameter ដាច់ដោយឡែក (ប្រសិនបើមិនប្រើ DATABASE_URL)
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_database_password
DB_NAME=postgres
DB_SSLMODE=require

# =====================================================================
# SECURITY & NOTIFICATIONS
# =====================================================================
JWT_SECRET=super_secret_vehicle_commerce_jwt_key_2026
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
FRONTEND_URL=http://localhost:3000
